---
import { geoArea, geoCentroid, geoNaturalEarth1, geoPath } from 'd3-geo'
import { feature } from 'topojson-client'
import { presimplify, simplify, quantile } from 'topojson-simplify'
import type { Topology, GeometryCollection } from 'topojson-specification'
import type { Feature, FeatureCollection, Geometry } from 'geojson'
import countries from 'i18n-iso-countries'
import en from 'i18n-iso-countries/langs/en.json'
import world110 from 'world-atlas/countries-110m.json'
import world50 from 'world-atlas/countries-50m.json'

interface Props {
  travel: { id: string; favourite: boolean }[]
}
const { travel } = Astro.props

type Countries = Topology<{ countries: GeometryCollection<{ name: string }> }>
type Land = FeatureCollection<Geometry, { name: string }>
countries.registerLocale(en)
const codeOf = (f: Feature) => (f.id ? countries.numericToAlpha2(String(f.id)) : undefined)
const toLand = (t: Countries): Land => {
  const fc = feature(t, t.objects.countries) as Land
  return { type: 'FeatureCollection', features: fc.features.filter((f) => f.id !== '010') }
}

const raw = presimplify(structuredClone(world110) as unknown as Countries)
const land = toLand(simplify(raw, quantile(raw, 0.2)))
const detailed = new Map(toLand(world50 as unknown as Countries).features.map((f) => [codeOf(f), f]))

const width = 680
const height = 330
const projection = geoNaturalEarth1().fitSize([width, height], land)
const path = geoPath(projection).digits(1)
const tiny = 9.5e-4

const byCode = new Map(travel.map((t) => [t.id, t]))
const nameOf = (code: string) => detailed.get(code)?.properties.name ?? countries.getName(code, 'en') ?? code
const visitedShapes = land.features.filter((f) => byCode.has(codeOf(f) ?? ''))
const outline = land.features.filter((f) => !visitedShapes.includes(f)).map((f) => path(f)).join('')
const shown = new Set(visitedShapes.filter((f) => geoArea(f) >= tiny).map(codeOf))
const dots = travel.flatMap((t) => {
  const f = detailed.get(t.id)
  const xy = !shown.has(t.id) && f ? projection(geoCentroid(f)) : null
  return xy ? [{ ...t, x: xy[0].toFixed(1), y: xy[1].toFixed(1) }] : []
})
const cls = (code: string) => ['visited', byCode.get(code)?.favourite && 'favourite']
const names = travel.map((t) => nameOf(t.id)).sort()
const favourites = travel.filter((t) => t.favourite).map((t) => nameOf(t.id))
---

<figure class="map">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`World map of ${travel.length} visited countries`}>
    <path class="land" d={outline} />
    {visitedShapes.map((f) => (
      <path class:list={cls(codeOf(f)!)} d={path(f)}><title>{f.properties.name}</title></path>
    ))}
    {dots.map((d) => (
      <circle class:list={cls(d.id)} cx={d.x} cy={d.y} r="2.6"><title>{nameOf(d.id)}</title></circle>
    ))}
  </svg>
  <figcaption>{travel.length} countries{favourites.length > 0 && ` · favourites: ${favourites.join(', ')}`}</figcaption>
  <ul class="sr-only">{names.map((n) => <li>{n}</li>)}</ul>
</figure>
