---
import { siX, siInstagram, siYoutube, siGithub } from 'simple-icons'
import type { linkIds } from '../content.config'

interface Props {
  id: (typeof linkIds)[number]
}
// simple-icons dropped LinkedIn, so its mark is drawn here.
const paths = {
  x: siX.path,
  instagram: siInstagram.path,
  youtube: siYoutube.path,
  github: siGithub.path,
  linkedin:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13M7.12 20.45H3.56V9h3.56z',
}
const { id } = Astro.props
---

<svg class="logo" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d={paths[id]} /></svg>
